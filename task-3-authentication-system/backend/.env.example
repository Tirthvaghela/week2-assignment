# Copy this file to .env and fill in your own values. Never commit the real .env.

# Secret key used to sign login tokens (JWT). Anyone who knows it can forge a
# login, so use a long random value and keep it private. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this is left empty, a temporary key is created each time the server
# starts, which logs everyone out on every restart.
JWT_SECRET=replace-with-a-long-random-value

# How long a login lasts, in minutes.
JWT_EXPIRES_MINUTES=60

# MongoDB connection string. For MongoDB Atlas use the mongodb+srv:// string,
# which contains a username and password.
MONGO_URI=mongodb://localhost:27017

# Database that holds the "users" collection.
MONGO_DB_NAME=authentication_system

# How long to wait for MongoDB before reporting it as unavailable.
MONGO_TIMEOUT_MS=3000

# Send the login cookie over HTTPS only. Keep 0 for local development over
# http://localhost, and set to 1 on any real (HTTPS) deployment.
COOKIE_SECURE=0

# Cross-site policy for the login cookie: Lax or Strict.
COOKIE_SAMESITE=Lax

# bcrypt work factor. Higher is slower to crack and slower to log in. 12 is a
# sensible default.
BCRYPT_ROUNDS=12

# Comma-separated list of frontend origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Flask server settings. Debug is off unless FLASK_DEBUG=1.
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0
