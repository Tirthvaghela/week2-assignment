# Copy this file to .env and adjust the values. Never commit the real .env.

# MongoDB connection string. For MongoDB Atlas use the mongodb+srv:// string
# from the Atlas dashboard, which contains your username and password.
MONGO_URI=mongodb://localhost:27017

# Database that holds the "employees" collection.
MONGO_DB_NAME=employee_management

# How long to wait for MongoDB before reporting it as unavailable.
MONGO_TIMEOUT_MS=3000

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Flask server settings. Use FLASK_DEBUG=1 only during development.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
